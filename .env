# Proxmox API connection
# The token secret is NOT kept here (this file is tracked in git). Put
# PROXMOX_TOKEN_SECRET=<uuid> in .env.local, which is gitignored.
# One or more cluster nodes, comma-separated, tried in order for failover
PROXMOX_HOST=10.0.0.22
PROXMOX_PORT=8006
PROXMOX_TOKEN_ID=mcp@pve!mcp
PROXMOX_CA_CERT=./secrets/pve-root-ca.pem

# MCP Server
MCP_PORT=3000
PROXMOX_NODE=pve3

# Guest protection
# Tag that marks a guest as un-migratable: migrate_guest refuses it, drain_node
# skips it, and cross-node clone_guest is blocked. Matched case-insensitively.
# Blank or unset falls back to the default, dont-move -- it cannot be used to
# turn the protection off.
PROXMOX_NO_MIGRATE_TAG=dont-move

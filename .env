# Proxmox SSH connection
PROXMOX_SSH_HOST=10.0.0.19
PROXMOX_SSH_USER=root
PROXMOX_SSH_KEY=~/.ssh/id_rsa

# MCP Server
MCP_PORT=3000
PROXMOX_NODE=pve3

# Guest protection
# Tag that marks a guest as un-migratable: migrate_guest refuses it, drain_node
# skips it, and cross-node clone_guest is blocked. Matched case-insensitively.
# Blank or unset falls back to the default, dont-move -- it cannot be used to
# turn the protection off.
PROXMOX_NO_MIGRATE_TAG=dont-move
